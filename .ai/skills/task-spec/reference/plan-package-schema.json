{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude.local/task-spec/plan-package.schema.json",
  "title": "Task Spec Plan Package",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "plan_package_id",
    "spec",
    "package_revision",
    "status",
    "created_at",
    "request_slug",
    "folder_name",
    "project_root",
    "package_root",
    "package_path",
    "source_proposal_sha256",
    "packages",
    "total_packages"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "plan_package_id": {"type": "string", "minLength": 1},
    "package_revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["READY_FOR_APPROVAL", "APPROVED", "REJECTED", "CHANGES_REQUESTED", "SUPERSEDED"]},
    "created_at": {"type": "string", "format": "date-time"},
    "request_slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80},
    "folder_name": {"type": "string", "pattern": "^[0-9]{8}-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "project_root": {"type": "string", "minLength": 1},
    "package_root": {"type": "string", "minLength": 1},
    "package_path": {"type": "string", "minLength": 1},
    "supersedes": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["revision", "path", "reason"],
          "properties": {
            "revision": {"type": "integer", "minimum": 1},
            "path": {"type": "string", "minLength": 1},
            "reason": {"type": "string"}
          },
          "additionalProperties": true
        }
      ]
    },
    "source_proposal_sha256": {"$ref": "#/$defs/sha256"},
    "plan_package_sha256": {"$ref": "#/$defs/sha256"},
    "spec": {"$ref": "#/$defs/spec"},
    "summary": {},
    "current_state": {},
    "target_state": {},
    "behavior": {},
    "business_rules": {},
    "scope": {},
    "risks": {"type": "array", "items": {"$ref": "#/$defs/identified_item"}},
    "technical_direction": {},
    "reference_code_assessment": {},
    "open_decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
    "acceptance_criteria": {"type": "array", "items": {"$ref": "#/$defs/identified_item"}},
    "implementation_boundary": {},
    "title": {"type": ["string", "null"]},
    "description": {"type": ["string", "null"]},
    "packages": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"$ref": "#/$defs/package"}},
    "total_packages": {"type": "integer", "minimum": 1, "maximum": 5}
  },
  "allOf": [
    {"if": {"required": ["packages", "total_packages"]}, "then": {"description": "total_packages equals the number of packages; dependency IDs form an acyclic graph."}}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "spec": {
      "type": "object",
      "required": ["spec_id", "revision", "project_id", "evidence_baseline"],
      "properties": {
        "spec_id": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 1},
        "path": {"type": ["string", "null"]},
        "sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "project_id": {"type": "string", "minLength": 1},
        "evidence_baseline": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "identified_item": {
      "type": "object",
      "required": ["id"],
      "properties": {"id": {"type": "string", "minLength": 1}},
      "additionalProperties": true
    },
    "decision": {
      "type": "object",
      "required": ["id", "resolution", "blocking"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "resolution": {"enum": ["auto-resolved", "user-required"]},
        "blocking": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "package": {
      "type": "object",
      "required": ["id", "name", "skill", "domain", "layer", "depends_on", "manifest", "boundaries", "contract"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "skill": {"type": "string"},
        "domain": {"type": "string"},
        "layer": {"type": "string"},
        "depends_on": {"type": "array", "items": {"type": "string"}},
        "manifest": {
          "type": "object",
          "required": ["knowledge", "rules", "packs", "patterns"],
          "properties": {
            "knowledge": {"type": "array", "items": {"type": "string"}},
            "rules": {"type": "array", "items": {"type": "string"}},
            "packs": {"type": "array", "items": {"type": "string"}},
            "patterns": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": true
        },
        "boundaries": {
          "type": "object",
          "required": ["allow_read", "allow_write", "forbid"],
          "properties": {
            "allow_read": {"type": "array", "items": {"type": "string"}},
            "allow_write": {"type": "array", "items": {"type": "string"}},
            "forbid": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": true
        },
        "contract": {
          "type": "object",
          "required": ["in_scope", "out_of_scope", "expected_files", "stop_condition"],
          "properties": {
            "in_scope": {},
            "out_of_scope": {},
            "expected_files": {},
            "stop_condition": {}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
